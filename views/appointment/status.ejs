<% layout("layouts/boilerplate") %>
<% const mode = viewerMode || (adminMode ? "admin" : "patient"); %>
<% const doctorSummary = mode === "doctor" && reviewSummary ? reviewSummary : null; %>

<div class="py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold mb-2">
        <%= mode === "admin" ? "Appointment Queue" : mode === "doctor" ? "Assigned Appointments" : "Appointment Status" %>
      </h1>
      <p class="text-muted mb-0">
        <%= mode === "admin" ? "Review requests, approve or reject them, and download receipts." : mode === "doctor" ? "Review your assigned appointments, approve or reject pending requests, and keep your schedule moving." : "Track your request and download the receipt once it is created." %>
      </p>
    </div>
    <% if (mode === "admin") { %>
      <a href="/dashboard" class="btn btn-outline-primary">Dashboard</a>
    <% } else if (mode === "doctor") { %>
      <a href="/dashboard" class="btn btn-outline-primary">Dashboard</a>
    <% } else { %>
      <a href="/appointment" class="btn btn-outline-primary">New Appointment</a>
    <% } %>
  </div>

  <% if (mode === "doctor" && doctorProfile) { %>
    <div class="alert alert-info border mb-4">
      <div class="fw-semibold mb-1"><%= doctorProfile.name || "Doctor" %></div>
      <div class="small">
        <%= doctorProfile.specialization || "-" %> | <%= doctorProfile.department || "-" %> | <%= doctorProfile.hospital_start_time || "-" %> to <%= doctorProfile.hospital_end_time || "-" %>
      </div>
    </div>
  <% } %>

  <% if (doctorSummary) { %>
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body">
            <div class="text-muted small">Assigned</div>
            <div class="h3 mb-0"><%= doctorSummary.total %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body">
            <div class="text-muted small">Pending</div>
            <div class="h3 mb-0"><%= doctorSummary.pending %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body">
            <div class="text-muted small">Approved</div>
            <div class="h3 mb-0"><%= doctorSummary.accepted %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body">
            <div class="text-muted small">Rejected</div>
            <div class="h3 mb-0"><%= doctorSummary.rejected %></div>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <div class="card">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <% if (mode === "doctor") { %>
                <th>Patient</th>
                <th>Contact</th>
                <th>Symptoms</th>
                <th>Date</th>
                <th>Time</th>
                <th>Urgency</th>
                <th>Status</th>
                <th>Actions</th>
              <% } else if (mode === "admin") { %>
                <th>User ID</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Specialist</th>
                <th>Date</th>
                <th>Time</th>
                <th>Urgency</th>
                <th>Status</th>
                <th>Receipt</th>
                <th>Actions</th>
                <th>Submitted</th>
              <% } else { %>
                <th>Doctor</th>
                <th>Specialist</th>
                <th>Date</th>
                <th>Time</th>
                <th>Urgency</th>
                <th>Status</th>
                <th>Receipt</th>
                <th>Submitted</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% if (!records || records.length === 0) { %>
              <tr>
                <td colspan="<%= mode === 'doctor' ? 8 : mode === 'admin' ? 11 : 8 %>" class="text-center py-4 text-muted">
                  <%= mode === "doctor" ? "No assigned appointments yet." : mode === "admin" ? "No appointment requests submitted yet." : "No appointment requests submitted yet." %>
                </td>
              </tr>
            <% } else { %>
              <% records.forEach((record) => { %>
                <% const patientUser = record.user_id && record.user_id.first_name ? record.user_id : null; %>
                <% const doctorUser = record.doctor_id && record.doctor_id.name ? record.doctor_id : null; %>
                <% const receiptUrl = "/appointments/" + record._id + "/receipt.pdf"; %>
                <% const statusClass = record.status === "Accepted" ? "success" : record.status === "Rejected" ? "danger" : "warning"; %>
                <tr>
                  <% if (mode === "doctor") { %>
                    <td>
                      <div class="fw-semibold"><%= patientUser ? patientUser.first_name + " " + patientUser.last_name : record.full_name || "-" %></div>
                      <div class="text-muted small"><%= patientUser ? patientUser.email : record.email || "-" %></div>
                    </td>
                    <td><%= record.phone || "-" %></td>
                    <td><%= record.symptoms || "-" %></td>
                    <td><%= record.appointment_date || "-" %></td>
                    <td><%= record.time_slot || "-" %></td>
                    <td>
                      <span class="badge text-bg-<%= record.urgency_level === 'high' ? 'danger' : record.urgency_level === 'medium' ? 'warning' : 'success' %>">
                        <%= record.urgency_level || "-" %>
                      </span>
                    </td>
                    <td>
                      <span class="badge text-bg-<%= statusClass %> text-uppercase">
                        <%= record.status === 'Accepted' ? 'Approved' : record.status %>
                      </span>
                    </td>
                    <td>
                      <% if (record.status === "Pending") { %>
                        <div class="d-flex flex-wrap gap-2">
                          <form action="/check-appointments/<%= record._id %>/accept" method="POST">
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                          </form>
                          <form action="/check-appointments/<%= record._id %>/reject" method="POST">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                          </form>
                        </div>
                      <% } else { %>
                        <span class="text-muted small">Reviewed</span>
                      <% } %>
                    </td>
                  <% } else if (mode === "admin") { %>
                    <td><%= record.user_id && record.user_id._id ? String(record.user_id._id) : record.user_id ? String(record.user_id) : "-" %></td>
                    <td>
                      <div class="fw-semibold"><%= patientUser ? patientUser.first_name + " " + patientUser.last_name : record.full_name || "-" %></div>
                      <div class="text-muted small"><%= patientUser ? patientUser.email : record.email || "-" %> | <%= record.phone || "-" %></div>
                      <div class="text-muted small">Patient type: <%= record.patient_type === "new" ? "New" : "Existing" %></div>
                    </td>
                    <td><%= doctorUser ? doctorUser.name : record.doctor_name || "-" %></td>
                    <td><%= record.specialization === "general_physician" ? "General Physician" : record.specialization === "orthopedic" ? "Orthopedic" : "Cardiology" %></td>
                    <td>
                      <div><%= record.appointment_date || "-" %></div>
                      <div class="text-muted small"><%= record.previous_visit ? "Previous visit" : "First visit" %></div>
                    </td>
                    <td><%= record.time_slot || "-" %></td>
                    <td>
                      <span class="badge text-bg-<%= record.urgency_level === 'high' ? 'danger' : record.urgency_level === 'medium' ? 'warning' : 'success' %>">
                        <%= record.urgency_level %>
                      </span>
                    </td>
                    <td>
                      <span class="badge text-bg-<%= statusClass %> text-uppercase">
                        <%= record.status === 'Accepted' ? 'Approved' : record.status %>
                      </span>
                    </td>
                    <td>
                      <a href="<%= receiptUrl %>" class="btn btn-sm btn-outline-secondary">Download</a>
                    </td>
                    <td>
                      <% if (record.status === "Pending") { %>
                        <div class="d-flex flex-wrap gap-2">
                          <form action="/check-appointments/<%= record._id %>/accept" method="POST">
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                          </form>
                          <form action="/check-appointments/<%= record._id %>/reject" method="POST">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                          </form>
                        </div>
                      <% } else { %>
                        <span class="text-muted small">No action</span>
                      <% } %>
                    </td>
                    <td><%= new Date(record.createdAt).toLocaleString() %></td>
                  <% } else { %>
                    <td><%= doctorUser ? doctorUser.name : record.doctor_name || "-" %></td>
                    <td>
                      <%= record.specialization === "general_physician" ? "General Physician" : record.specialization === "orthopedic" ? "Orthopedic" : "Cardiology" %>
                    </td>
                    <td><%= record.appointment_date || "-" %></td>
                    <td><%= record.time_slot || "-" %></td>
                    <td>
                      <span class="badge text-bg-<%= record.urgency_level === 'high' ? 'danger' : record.urgency_level === 'medium' ? 'warning' : 'success' %>">
                        <%= record.urgency_level %>
                      </span>
                    </td>
                    <td>
                      <span class="badge text-bg-<%= statusClass %> text-uppercase">
                        <%= record.status === 'Accepted' ? 'Approved' : record.status %>
                      </span>
                    </td>
                    <td>
                      <a href="<%= receiptUrl %>" class="btn btn-sm btn-outline-secondary">Download</a>
                    </td>
                    <td><%= new Date(record.createdAt).toLocaleString() %></td>
                  <% } %>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
