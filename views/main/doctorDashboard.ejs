<% layout("layouts/boilerplate") %>
<% const assignedRows = Array.isArray(assignedAppointments) ? assignedAppointments : []; %>
<% const availabilityDays = doctorProfile && Array.isArray(doctorProfile.availability_days) ? doctorProfile.availability_days.length : (typeof availabilityDaysCount !== "undefined" ? availabilityDaysCount : 0); %>
<% const assignedCountValue = typeof assignedCount !== "undefined" ? assignedCount : assignedRows.length; %>
<% const approvedCountValue = typeof acceptedCount !== "undefined" ? acceptedCount : assignedRows.filter((record) => String(record.status || "").trim() === "Accepted").length; %>
<% const pendingCountValue = typeof pendingAppointmentCount !== "undefined" ? pendingAppointmentCount : assignedRows.filter((record) => String(record.status || "").trim() === "Pending").length; %>
<% const workloadPerDayValue = typeof workloadPerDay !== "undefined" ? workloadPerDay : (availabilityDays > 0 ? Math.ceil((assignedCountValue || 0) / availabilityDays) : assignedCountValue || 0); %>

<div class="py-4 py-lg-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold mb-2">Doctor Dashboard</h1>
      <p class="text-muted mb-0">Review assigned appointments, track workload, and keep the schedule moving.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/check-appointments" class="btn btn-outline-primary btn-sm">Review Queue</a>
      <a href="/profile" class="btn btn-outline-secondary btn-sm">Profile</a>
    </div>
  </div>

  <% if ((pendingAppointmentCount || 0) > 0) { %>
    <div class="alert alert-warning border d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <div class="fw-semibold">New appointment requests</div>
        <div class="small text-muted">These are waiting for your review.</div>
      </div>
      <span class="badge text-bg-dark"><%= pendingAppointmentCount %> pending</span>
    </div>
  <% } %>

  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Assigned Appointments</div>
          <div class="h3 mb-0"><%= assignedCountValue || 0 %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Pending Reviews</div>
          <div class="h3 mb-0"><%= pendingCountValue || 0 %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Approved</div>
          <div class="h3 mb-0"><%= approvedCountValue || 0 %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Workload / Day</div>
          <div class="h3 mb-0"><%= workloadPerDayValue || 0 %></div>
          <div class="small text-muted"><%= availabilityDays || 0 %> active days</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-lg-5">
      <div class="card h-100">
        <div class="card-body p-4">
          <h2 class="h5 mb-3">Doctor Profile</h2>
          <% if (doctorProfile) { %>
            <dl class="row mb-0">
              <dt class="col-5 text-muted fw-normal">Name</dt>
              <dd class="col-7"><%= doctorProfile.name || profile.fullName || "-" %></dd>

              <dt class="col-5 text-muted fw-normal">Specialization</dt>
              <dd class="col-7"><%= doctorProfile.specialization === "general_physician" ? "General Physician" : doctorProfile.specialization === "orthopedic" ? "Orthopedic" : "Cardiology" %></dd>

              <dt class="col-5 text-muted fw-normal">Department</dt>
              <dd class="col-7"><%= doctorProfile.department || "-" %></dd>

              <dt class="col-5 text-muted fw-normal">Hospital Time</dt>
              <dd class="col-7"><%= doctorProfile.hospital_start_time || "-" %> to <%= doctorProfile.hospital_end_time || "-" %></dd>

              <dt class="col-5 text-muted fw-normal">Days</dt>
              <dd class="col-7"><%= (doctorProfile.availability_days || []).join(", ") || "-" %></dd>

              <dt class="col-5 text-muted fw-normal">Account Status</dt>
              <dd class="col-7">
                <span class="badge text-bg-<%= doctorProfile.active ? 'success' : 'secondary' %> text-uppercase">
                  <%= doctorProfile.active ? "Active" : "Inactive" %>
                </span>
              </dd>
            </dl>
            <% if (!doctorProfile.active) { %>
              <div class="alert alert-warning mt-3 mb-0">Your doctor profile is inactive, so patients will not see you in the booking list.</div>
            <% } %>
          <% } else { %>
            <div class="alert alert-warning mb-0">No doctor profile found for this account.</div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card h-100">
        <div class="card-body p-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Assigned Appointments</h2>
            <span class="badge text-bg-light border"><%= assignedRows.length %> records</span>
          </div>

          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 mobile-table-cards">
              <thead class="table-light">
                <tr>
                  <th>Patient</th>
                  <th>Email</th>
                  <th>Date</th>
                  <th>Time</th>
                  <th>Urgency</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (!assignedRows || assignedRows.length === 0) { %>
                  <tr>
                    <td colspan="6" class="text-center py-4 text-muted">No assigned appointments yet.</td>
                  </tr>
                <% } else { %>
                  <% assignedRows.forEach((record) => { %>
                    <% const patientUser = record.user_id && record.user_id.first_name ? record.user_id : null; %>
                    <% const statusClass = record.status === "Accepted" ? "success" : record.status === "Rejected" ? "danger" : "warning"; %>
                    <tr>
                      <td data-label="Patient">
                        <div class="fw-semibold"><%= patientUser ? patientUser.first_name + " " + patientUser.last_name : record.full_name || "-" %></div>
                      </td>
                      <td data-label="Email"><%= patientUser ? patientUser.email : record.email || "-" %></td>
                      <td data-label="Date"><%= record.appointment_date || "-" %></td>
                      <td data-label="Time"><%= record.time_slot || "-" %></td>
                      <td data-label="Urgency"><span class="badge text-bg-<%= record.urgency_level === 'high' ? 'danger' : record.urgency_level === 'medium' ? 'warning' : 'success' %>"><%= record.urgency_level || "-" %></span></td>
                      <td data-label="Status"><span class="badge text-bg-<%= statusClass %> text-uppercase"><%= record.status === "Accepted" ? "Approved" : record.status %></span></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-lg-7">
      <div class="card h-100">
        <div class="card-body p-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Weekly Schedule</h2>
            <span class="badge text-bg-light border">Auto-generated from working hours</span>
          </div>

          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 mobile-table-cards">
              <thead class="table-light">
                <tr>
                  <th>Day</th>
                  <th>Date</th>
                  <th>Window</th>
                  <th>Slots</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (!weeklySchedule || weeklySchedule.length === 0) { %>
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">No weekly schedule available.</td>
                  </tr>
                <% } else { %>
                  <% weeklySchedule.forEach((slot) => { %>
                    <tr>
                    <td data-label="Day"><%= slot.day %></td>
                    <td data-label="Date"><%= slot.dateLabel %></td>
                    <td data-label="Window"><%= slot.timeWindow %></td>
                    <td data-label="Slots"><%= slot.slots && slot.slots.length ? slot.slots.join(", ") : "-" %></td>
                    <td data-label="Status">
                      <span class="badge text-bg-<%= slot.available ? 'success' : 'secondary' %> text-uppercase">
                        <%= slot.available ? "Available" : "Off" %>
                      </span>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card h-100">
        <div class="card-body p-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Appointment Alerts</h2>
            <span class="badge text-bg-light border"><%= appointmentNotifications ? appointmentNotifications.length : 0 %> recent</span>
          </div>

          <% if (!appointmentNotifications || appointmentNotifications.length === 0) { %>
            <div class="alert alert-info mb-0">No appointment alerts yet. New requests will appear here automatically.</div>
          <% } else { %>
            <div class="list-group list-group-flush">
              <% appointmentNotifications.forEach((notification) => { %>
                <div class="list-group-item px-0">
                  <div class="fw-semibold"><%= notification.title || "Appointment update" %></div>
                  <div class="small text-muted mb-1"><%= notification.message || "-" %></div>
                  <div class="small text-muted d-flex justify-content-between gap-3">
                    <span><%= new Date(notification.createdAt).toLocaleString() %></span>
                    <% if (notification.link) { %>
                      <a href="<%= notification.link %>">Open</a>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
