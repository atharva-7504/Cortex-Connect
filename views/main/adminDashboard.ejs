<% layout("layouts/boilerplate") %>

<%
  const bedCategoryLabels = {
    normal: "Normal",
    critical: "Critical",
    icu: "ICU"
  };

  const formatDateLabel = (value) => {
    if (!value) return "-";
    const date = new Date(`${value}T00:00:00`);
    if (Number.isNaN(date.getTime())) return String(value);
    return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
  };

  const formatDateTimeLabel = (value) => {
    if (!value) return "-";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return date.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit"
    });
  };

  const titleize = (value) => {
    const text = String(value || "").trim();
    if (!text) return "-";
    return text
      .replace(/_/g, " ")
      .replace(/\b\w/g, (character) => character.toUpperCase());
  };

  const statusClass = (value) => {
    const normalized = String(value || "").trim().toLowerCase();
    if (normalized === "accepted" || normalized === "approved") return "bg-success";
    if (normalized === "rejected") return "bg-danger";
    if (normalized === "pending") return "bg-warning text-dark";
    if (normalized === "active") return "bg-success";
    if (normalized === "inactive") return "bg-secondary";
    return "bg-light text-dark border";
  };

  const bedOccupancyPct = Number(bedSummary ? bedSummary.occupancyPct : 0);
  const bedOccupancyDisplay = Math.max(0, Math.min(bedOccupancyPct || 0, 100));
  const totalAppointments = Number(appointmentCount || 0);
  const staffCoveragePctValue = Number(staffCoveragePct || 0);
  const doctorAvailabilityPctValue = Number(doctorAvailabilityPct || 0);
%>

<div class="dashboard-page">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">Dashboard</h1>
      <p class="text-muted mb-0">Operations overview for CortexConnect.</p>
    </div>
    <div class="dashboard-toolbar d-flex flex-wrap gap-2">
      <a href="/check-appointments" class="btn btn-outline-primary btn-sm">Appointments</a>
      <% if (profile && profile.role === "admin") { %>
        <a href="/bed-admissions" class="btn btn-outline-primary btn-sm">Bed Admissions</a>
      <% } %>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card dashboard-stat-card h-100">
        <div class="card-body">
          <div class="dashboard-stat-label">Patients</div>
          <div class="dashboard-stat-value"><%= patientCount %></div>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card dashboard-stat-card h-100">
        <div class="card-body">
          <div class="dashboard-stat-label">Appointments</div>
          <div class="dashboard-stat-value"><%= totalAppointments %></div>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card dashboard-stat-card h-100">
        <div class="card-body">
          <div class="dashboard-stat-label">Bed Occupancy</div>
          <div class="dashboard-stat-value"><%= bedOccupancyDisplay %>%</div>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card dashboard-stat-card h-100">
        <div class="card-body">
          <div class="dashboard-stat-label">Staff Coverage</div>
          <div class="dashboard-stat-value"><%= staffCoveragePctValue %>%</div>
        </div>
      </div>
    </div>
  </div>

  <div class="accordion dashboard-accordion" id="adminAnalyticsAccordion">
    <div class="accordion-item">
      <h2 class="accordion-header" id="appointmentsHeading">
        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#appointmentsCollapse" aria-expanded="true" aria-controls="appointmentsCollapse">
          Appointment Analysis
        </button>
      </h2>
      <div id="appointmentsCollapse" class="accordion-collapse collapse show" aria-labelledby="appointmentsHeading" data-bs-parent="#adminAnalyticsAccordion">
        <div class="accordion-body">
          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Pending</div>
                <div class="dashboard-mini-value"><%= pendingCount %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Approved</div>
                <div class="dashboard-mini-value"><%= acceptedCount %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Rejected</div>
                <div class="dashboard-mini-value"><%= rejectedCount %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">High Urgency</div>
                <div class="dashboard-mini-value"><%= highUrgencyAppointmentCount || 0 %></div>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Approval Rate</div>
                <div class="dashboard-mini-value"><%= appointmentApprovalRate || 0 %>%</div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Pending Share</div>
                <div class="dashboard-mini-value"><%= appointmentPendingRate || 0 %>%</div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Rejection Rate</div>
                <div class="dashboard-mini-value"><%= appointmentRejectionRate || 0 %>%</div>
              </div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm align-middle dashboard-table mb-0 mobile-table-cards">
              <thead>
                <tr>
                  <th>Patient</th>
                  <th>Doctor</th>
                  <th>Date</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentAppointments && recentAppointments.length) { %>
                  <% recentAppointments.forEach((appointment) => { %>
                    <tr>
                      <td data-label="Patient"><%= appointment.full_name || "-" %></td>
                      <td data-label="Doctor"><%= appointment.doctor_name || appointment.doctor_id?.name || "-" %></td>
                      <td data-label="Date"><%= formatDateLabel(appointment.appointment_date) %></td>
                      <td data-label="Status">
                        <span class="badge rounded-pill <%= statusClass(appointment.status) %>"><%= titleize(appointment.status) %></span>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4">
                      <div class="dashboard-empty">No appointments yet.</div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="accordion-item">
      <h2 class="accordion-header" id="bedsHeading">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#bedsCollapse" aria-expanded="false" aria-controls="bedsCollapse">
          Bed Analysis
        </button>
      </h2>
      <div id="bedsCollapse" class="accordion-collapse collapse" aria-labelledby="bedsHeading" data-bs-parent="#adminAnalyticsAccordion">
        <div class="accordion-body">
          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Total Beds</div>
                <div class="dashboard-mini-value"><%= bedSummary ? bedSummary.totalBeds : 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Occupied</div>
                <div class="dashboard-mini-value"><%= bedSummary ? bedSummary.occupiedBeds : 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Free</div>
                <div class="dashboard-mini-value"><%= bedSummary ? bedSummary.freeBeds : 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Occupancy</div>
                <div class="dashboard-mini-value"><%= bedOccupancyDisplay %>%</div>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Normal Demand</div>
                <div class="dashboard-mini-value"><%= bedSummary ? bedSummary.normalBeds : 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Critical Demand</div>
                <div class="dashboard-mini-value"><%= bedSummary ? bedSummary.criticalBeds : 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">ICU Demand</div>
                <div class="dashboard-mini-value"><%= bedSummary ? bedSummary.icuBeds : 0 %></div>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Admissions Today</div>
                <div class="dashboard-mini-value"><%= bedSummary ? bedSummary.admissionsToday : 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Discharges Today</div>
                <div class="dashboard-mini-value"><%= bedSummary ? bedSummary.dischargesToday : 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Expected Discharges</div>
                <div class="dashboard-mini-value"><%= bedSummary ? bedSummary.expectedDischarges : 0 %></div>
              </div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm align-middle dashboard-table mb-0 mobile-table-cards">
              <thead>
                <tr>
                  <th>Patient</th>
                  <th>Category</th>
                  <th>Beds</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (bedSummary && bedRecords && bedRecords.length) { %>
                  <% bedRecords.forEach((record) => { %>
                    <% const totalBeds = Number(record.total_beds || 0); %>
                    <% const occupiedBeds = Number(record.occupied_beds || 0); %>
                    <% const freeBeds = Math.max(totalBeds - occupiedBeds, 0); %>
                    <tr>
                      <td data-label="Patient"><%= record.patient_name || "-" %></td>
                      <td data-label="Category"><%= bedCategoryLabels[record.bed_category] || titleize(record.bed_category) %></td>
                      <td data-label="Beds"><%= occupiedBeds %> / <%= totalBeds %> <span class="text-muted">(<%= freeBeds %> free)</span></td>
                      <td data-label="Date"><%= formatDateLabel(record.admission_date) %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4">
                      <div class="dashboard-empty">No bed admissions yet.</div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="accordion-item">
      <h2 class="accordion-header" id="teamHeading">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#teamCollapse" aria-expanded="false" aria-controls="teamCollapse">
          Team Analysis
        </button>
      </h2>
      <div id="teamCollapse" class="accordion-collapse collapse" aria-labelledby="teamHeading" data-bs-parent="#adminAnalyticsAccordion">
        <div class="accordion-body">
          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Total Doctors</div>
                <div class="dashboard-mini-value"><%= doctorCount || 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Active Doctors</div>
                <div class="dashboard-mini-value"><%= activeDoctorCount || 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Availability</div>
                <div class="dashboard-mini-value"><%= doctorAvailabilityPctValue %>%</div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Staff Coverage</div>
                <div class="dashboard-mini-value"><%= staffCoveragePctValue %>%</div>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Active Staff</div>
                <div class="dashboard-mini-value"><%= staffActiveCount || 0 %> / <%= staffTotalCount || 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Workload / Doctor</div>
                <div class="dashboard-mini-value"><%= doctorWorkloadAverage || 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Queue Load</div>
                <div class="dashboard-mini-value"><%= doctorAppointmentLoad || 0 %></div>
              </div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm align-middle dashboard-table mb-0 mobile-table-cards">
              <thead>
                <tr>
                  <th>Doctor</th>
                  <th>Department</th>
                  <th>Status</th>
                  <th>Hours</th>
                </tr>
              </thead>
              <tbody>
                <% if (doctorRows && doctorRows.length) { %>
                  <% doctorRows.forEach((doctor) => { %>
                    <tr>
                      <td data-label="Doctor"><%= doctor.staff_name || "-" %></td>
                      <td data-label="Department"><%= doctor.department || "-" %></td>
                      <td data-label="Status">
                        <span class="badge rounded-pill <%= statusClass(doctor.status) %>"><%= titleize(doctor.status) %></span>
                      </td>
                      <td data-label="Hours"><%= doctor.hours_label || "-" %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4">
                      <div class="dashboard-empty">No staff data available.</div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="accordion-item">
      <h2 class="accordion-header" id="requestsHeading">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#requestsCollapse" aria-expanded="false" aria-controls="requestsCollapse">
          Bed Request Analysis
        </button>
      </h2>
      <div id="requestsCollapse" class="accordion-collapse collapse" aria-labelledby="requestsHeading" data-bs-parent="#adminAnalyticsAccordion">
        <div class="accordion-body">
          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Total Requests</div>
                <div class="dashboard-mini-value"><%= bedRequestCount || 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Pending</div>
                <div class="dashboard-mini-value"><%= bedRequestPendingCount || 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Approved</div>
                <div class="dashboard-mini-value"><%= bedRequestApprovedCount || 0 %></div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Rejected</div>
                <div class="dashboard-mini-value"><%= bedRequestRejectedCount || 0 %></div>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Pending Share</div>
                <div class="dashboard-mini-value"><%= bedRequestPendingRate || 0 %>%</div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Approved Share</div>
                <div class="dashboard-mini-value"><%= bedRequestApprovedRate || 0 %>%</div>
              </div>
            </div>
            <div class="col-12 col-sm-4">
              <div class="dashboard-mini-card">
                <div class="dashboard-mini-label">Rejected Share</div>
                <div class="dashboard-mini-value"><%= bedRequestRejectedRate || 0 %>%</div>
              </div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm align-middle dashboard-table mb-0 mobile-table-cards">
              <thead>
                <tr>
                  <th>Patient</th>
                  <th>Doctor</th>
                  <th>Category</th>
                  <th>Status</th>
                  <th>Created</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentBedRequests && recentBedRequests.length) { %>
                  <% recentBedRequests.forEach((request) => { %>
                    <tr>
                      <td data-label="Patient"><%= request.patient_name || "-" %></td>
                      <td data-label="Doctor"><%= request.doctor_id?.name || request.doctor_name || "-" %></td>
                      <td data-label="Category"><%= bedCategoryLabels[request.bed_category] || titleize(request.bed_category) %></td>
                      <td data-label="Status">
                        <span class="badge rounded-pill <%= statusClass(request.status) %>"><%= titleize(request.status) %></span>
                      </td>
                      <td data-label="Created"><%= formatDateTimeLabel(request.createdAt) %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5">
                      <div class="dashboard-empty">No bed requests yet.</div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
